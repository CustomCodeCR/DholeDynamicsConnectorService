# Local development only. Generate unique values; never commit .env or copy to staging/production.
POSTGRES_PASSWORD=
DYNAMICS_ENCRYPTION_KEY_BASE64=
# Optional: during key rotation, retain version 1 until all rows and backups have migrated.
DYNAMICS_ENCRYPTION_KEYS_JSON=
DYNAMICS_ENCRYPTION_ACTIVE_KEY_VERSION=1
# OIDC Admin and external OAuth2 resource-server configuration (no shared JWT signing key).
ADMIN_PUBLIC_ORIGIN=
ADMIN_OIDC_AUTHORITY=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
M2M_AUTHORITY=
M2M_AUDIENCE=

# Only schedules explicitly enabled per connection run. Local Compose enables scheduler.
METADATA_SCHEDULER_ENABLED=true

# Required in staging/production: external random 32-byte Base64 cursor key.
READ_CURSOR_KEY_BASE64=

# Opt-in durable worker (disabled by default, independent from Dhole infra).
DYNAMICS_JOBS_ENABLED=false
