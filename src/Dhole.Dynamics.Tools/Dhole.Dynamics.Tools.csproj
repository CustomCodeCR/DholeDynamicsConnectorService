<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <ProjectReference Include="../Dhole.Dynamics.Infrastructure/Dhole.Dynamics.Infrastructure.csproj" />
    <ProjectReference Include="../Dhole.Dynamics.Domain/Dhole.Dynamics.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Include every versioned SQL migration in build and publish output.
         This avoids missing-file errors when adding the next migration. -->
    <Content Include="../../sql/*.sql"
             Link="migrations/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
