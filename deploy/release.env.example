# RELEASE ONLY; provide different values, hosts, database volumes, keys and tenant per environment.
# Never commit the filled values. Production defaults to fully read-only and disabled jobs.
DYNAMICS_STACK_NAME=dhole-dynamics-staging
DYNAMICS_ENVIRONMENT=Staging
DYNAMICS_PUBLIC_FQDN=connector-staging.example.com
DYNAMICS_ACME_EMAIL=ops@example.com
DYNAMICS_RELEASE_TAG=sha-REPLACE_WITH_APPROVED_COMMIT
DYNAMICS_POSTGRES_PASSWORD_FILE=/etc/dhole-dynamics/staging/postgres_password
DYNAMICS_CONNECTOR_DB_FILE=/etc/dhole-dynamics/staging/connector_connection
DYNAMICS_ENCRYPTION_KEY_FILE=/etc/dhole-dynamics/staging/dynamics_encryption_key
DYNAMICS_CURSOR_KEY_FILE=/etc/dhole-dynamics/staging/read_cursor_key
DYNAMICS_ADMIN_OIDC_SECRET_FILE=/etc/dhole-dynamics/staging/admin_oidc_client_secret
DYNAMICS_DP_CERT_FILE=/etc/dhole-dynamics/staging/data_protection_cert.pfx
DYNAMICS_DP_PASSWORD_FILE=/etc/dhole-dynamics/staging/data_protection_password
DYNAMICS_ADMIN_OIDC_AUTHORITY=https://login.microsoftonline.com/REPLACE_STAGING_TENANT/v2.0
DYNAMICS_ADMIN_OIDC_CLIENT_ID=REPLACE_STAGING_APP_ID
DYNAMICS_M2M_AUTHORITY=https://login.microsoftonline.com/REPLACE_STAGING_TENANT/v2.0
DYNAMICS_M2M_AUDIENCE=api://REPLACE_STAGING_RESOURCE
DYNAMICS_JOBS_ENABLED=false
DYNAMICS_PRODUCTION_WRITES_APPROVED=NO
DYNAMICS_PRODUCTION_WRITES_TICKET=
DYNAMICS_PRODUCTION_DELETES_APPROVED=NO
DYNAMICS_PRODUCTION_DELETES_TICKET=
