{
  email {$ACME_CONTACT_EMAIL}
  admin off
}
{$PUBLIC_FQDN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
  request_body {
    max_size 4MB
  }
  reverse_proxy admin:80
}
